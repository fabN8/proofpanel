# Copy nothing by hand: `npm run setup` creates .env.local with the first three values.
# With no .env.local at all, the app runs in simulation mode (no blockchain).

# The platform wallet: pays network fees, hands out test USDC, triggers payouts.
PLATFORM_SECRET_KEY=
# Signs the sign-in cookie.
SESSION_SECRET=
# Solana devnet endpoint. The public one is rate-limited per internet address (a problem on
# shared networks). With a free key from https://www.helius.dev use instead:
#   https://devnet.helius-rpc.com/?api-key=YOUR_KEY
SOLANA_RPC_URL=https://api.devnet.solana.com

# Optional -----------------------------------------------------------------------------

# Force an engine: mock | vault | escrow.
# Default: mock without a platform key, vault with one, escrow when ESCROW_PROGRAM_ID is set.
CHAIN_ENGINE=
# Address of the deployed escrow program (see README, "The escrow program").
ESCROW_PROGRAM_ID=
# Test USDC token. Default is Circle's devnet USDC.
USDC_MINT=4zMMC9srt5Ri5X14GAgXhaHii3GnPAEERYPJgZJDncDU
# USDC the demo faucet gives each researcher.
FAUCET_USDC=5
# Share of the expected duration a participant must spend before being paid (0.33 = a third).
MIN_TIME_FACTOR=
# Email login with user-held wallets (https://dashboard.privy.io). Both values switch it on.
PRIVY_APP_ID=
PRIVY_APP_SECRET=
# Keep the demo sign-in available although Privy is on (testing only).
ALLOW_DEMO_SIGNIN=

# World ID human check (https://developer.world.org). All three values switch it on.
WORLD_APP_ID=
WORLD_RP_ID=
WORLD_SIGNING_KEY=
# staging = World's simulator, production = real World IDs.
WORLD_ENVIRONMENT=staging

# Hosted Postgres (Neon). Needed on Vercel; leave empty locally to use the built-in file database.
DATABASE_URL=
# Public address of the app. Leave empty locally; it is detected from the request.
APP_URL=
